{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "akari",
  "mainBinaryName": "akari",
  "version": "0.1.0",
  "identifier": "io.github.sjonathan15.akari",
  "build": {
    "frontendDist": "vacio"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "sJonathan15",
    "copyright": "MIT",
    "category": "Utility",
    "shortDescription": "Burbujas de escritorio: uso de Claude Code y Codex, batería de tus periféricos y habilidades de IA",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../akari/": "servicio/akari/",
      "../bin/akari.py": "servicio/bin/akari.py",
      "../web/": "servicio/web/",
      "../modelos/": "servicio/modelos/",
      "../iconos/": "servicio/iconos/",
      "../capsulas/": "servicio/capsulas/",
      "recursos/python/": "python/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/ganchos.nsh",
        "compression": "lzma"
      }
    }
  }
}
